{
  "name": "pokemon-game-builder",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "A framework for building Pokemon games using RPG Maker XP, Pokemon Essentials and AI.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "main:build": "tsc -p tsconfig.main.json",
    "main:watch": "tsc -p tsconfig.main.json --watch",
    "build": "npm run main:build && vite build && electron-builder",
    "preview": "vite preview",
    "dev:desktop": "concurrently \"npm run dev\" \"npm run main:watch\" \"wait-on http://localhost:5173 dist/main/main.js && electron .\"",
    "dev:browser": "concurrently \"npm run dev\" \"npm run main:watch\" \"wait-on dist/main/browser-server.js && node dist/main/browser-server.js\"",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.renderer.config.ts",
    "test:main": "vitest run --config vitest.config.ts",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fs-extra": "^11.2.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.1.2",
    "wait-on": "^7.2.0"
  }
}
